<Window x:Class="Veterinario_MVVM.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Veterinario_MVVM.ViewModels"
        xmlns:views="clr-namespace:Veterinario_MVVM.Views"
        x:Name="VentanaPrincipal"
        Title="VetCare Studio - Panel Principal de la Clínica"
        Height="800" Width="1280" MinHeight="660" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Language="es-ES"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource BrushFondo}">

    <!-- Plantilla de Mapeo (DataTemplate): WPF resuelve el UserControl del ViewModel activo -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:PacientesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdmisionViewModel}">
            <views:AdmisionView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Barra superior: banner oscuro con nombre de la clínica, veterinario en sesión y botón de salida -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushBanner}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrushPrimario}">
                        <TextBlock Text="🐾" FontFamily="Segoe UI Emoji" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="VetCare Studio" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Clínica veterinaria · Panel principal" FontSize="12" Foreground="#C9DCE6"/>
                    </StackPanel>
                </StackPanel>

                <!-- Barra de Navegación Superior: alterna entre el panel de pacientes y la ficha de admisión -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="30,0" VerticalAlignment="Center">
                    <Button Content="Ge_stión de pacientes" TabIndex="30"
                            Style="{StaticResource EstiloBotonMenu}"
                            Tag="{Binding PacientesActivo}"
                            Command="{Binding MostrarPacientesCommand}"
                            AutomationProperties.Name="Gestión de pacientes"
                            AutomationProperties.HelpText="Muestra el listado de pacientes y el formulario de alta y edición"/>
                    <Button Content="Admisión _hospitalaria" TabIndex="31"
                            Style="{StaticResource EstiloBotonMenu}"
                            Tag="{Binding AdmisionActiva}"
                            Command="{Binding MostrarAdmisionCommand}"
                            AutomationProperties.Name="Admisión hospitalaria"
                            AutomationProperties.HelpText="Muestra la ficha de admisión hospitalaria con validación de datos"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding NombreUsuario}" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding RolUsuario}" FontSize="12" Foreground="{StaticResource BrushCrema}"
                               HorizontalAlignment="Right"/>
                </StackPanel>

                <Button Grid.Column="3" Content="_Cerrar sesión" TabIndex="32" Height="38"
                        Style="{StaticResource EstiloBotonSecundario}"
                        Command="{Binding CerrarSesionCommand}"
                        CommandParameter="{Binding ElementName=VentanaPrincipal}"
                        AutomationProperties.Name="Cerrar sesión"
                        AutomationProperties.HelpText="Cierra el panel principal y vuelve a la pantalla de acceso"/>
            </Grid>
        </Border>

        <!-- Barra inferior (StatusBar): contador de pacientes registrados y mensaje reactivo de estado -->
        <StatusBar DockPanel.Dock="Bottom" Background="White" Padding="15,3"
                   BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding MensajeEstado}" FontSize="12" Foreground="{StaticResource BrushTexto2}"
                           AutomationProperties.LiveSetting="Polite"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock FontSize="12" Foreground="{StaticResource BrushTexto2}" AutomationProperties.LiveSetting="Polite">
                    <Run Text="Pacientes registrados:"/>
                    <Run Text="{Binding TotalPacientes, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- Contenedor Dinámico Central: ContentControl enlazado a la propiedad de navegación -->
        <ContentControl Content="{Binding VistaActual, ValidatesOnNotifyDataErrors=False}" Margin="20" Focusable="False"/>
    </DockPanel>
</Window>
